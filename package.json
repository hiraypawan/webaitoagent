{
  "name": "web-agents-to",
  "version": "1.3.1",
  "description": "Turn a free web AI chat UI into a local OpenAI-compatible API, CLI and browser extension.",
  "type": "module",
  "main": "dist/server/main.js",
  "bin": {
    "web": "./bin/web.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "extension",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/main.js",
    "cli": "tsx src/cli/index.ts",
    "repl": "tsx src/cli/repl.ts",
    "agent": "tsx src/cli/agent.ts",
    "login": "tsx src/cli/login.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "setup": "tsx src/cli/setup.ts",
    "logout": "tsx src/cli/logout.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "openai-compatible",
    "llm",
    "playwright",
    "browser-automation",
    "cli",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiraypawan/webaitoagent.git"
  },
  "author": "hiraypawan",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "playwright": "^1.64.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
