{
  "manifest_version": 3,
  "name": "Web Agents To",
  "version": "1.1.0",
  "description": "Chat with your local web-agents-to API from a floating panel.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://aistudio.xiaomimimo.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aistudio.xiaomimimo.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
