# ---------------------------------------------------------------------------
# web-agents-to configuration (copy to .env, never commit .env)
# ---------------------------------------------------------------------------

# Server
PORT=8787
# Keep loopback unless you front it with TLS/auth of your own.
HOST=127.0.0.1
# Default development key. CHANGE THIS before exposing the server anywhere.
API_KEY=web-agents-to
# Extra allowed CORS origins (comma separated). Loopback + browser extensions
# are always allowed; set this only for a hosted UI.
CORS_ORIGINS=
# Refuse to start on a non-loopback HOST with the default API key.
ALLOW_INSECURE=false
LOG_LEVEL=info

# Browser
# false = watch the browser work (needed for the first login).
HEADLESS=true
# Defaults to ~/.web-agents-to/profiles
PROFILE_ROOT=
# Use an existing Chromium binary (Docker/CI) instead of Playwright's download.
CHROMIUM_EXECUTABLE=
# Optional JSON patch for provider selectors/URLs when a site redesigns:
#   SITE_OVERRIDES=./providers.mimo.json
SITE_OVERRIDES=
# Only for Xiaomi password accounts; Google SSO must be done interactively.
MIMO_USER=
MIMO_PASS=

# Provider behaviour
# Overall budget for one request.
REQUEST_TIMEOUT_MS=180000
# How often the page is scraped while an answer is being generated.
STREAM_POLL_MS=250
# Consecutive unchanged polls that mean "the answer is finished".
STREAM_IDLE_POLLS=6
# Give up if an answer has not started (STREAM_START_TIMEOUT_MS) or has not
# finished (STREAM_MAX_WAIT_MS) within these limits.
STREAM_START_TIMEOUT_MS=45000
STREAM_MAX_WAIT_MS=180000
# Retries for "server busy" / transient browser failures.
PROVIDER_RETRIES=3
PROVIDER_RETRY_DELAY_MS=2000
# Requests queued per provider while one chat is in flight.
MAX_QUEUE=16
MAX_PROMPT_CHARS=120000
# Convert <tool_call> blocks into native OpenAI tool_calls for tool-aware clients.
NATIVE_TOOLS=true
# Comma separated provider ids (empty = all registered).
PROVIDERS=

# Agent CLI (WEB / npm run agent)
# Auto-approve shell commands and file edits instead of asking.
AGENT_AUTO_APPROVE=false
AGENT_MAX_STEPS=12
AGENT_BASH_TIMEOUT_MS=60000
AGENT_MAX_OUTPUT_CHARS=20000
# Allow the tools to read/write outside the workspace root.
AGENT_ALLOW_OUTSIDE=false
